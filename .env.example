# Local docker-compose PostgreSQL does not enable TLS.
# Render: jdbc:postgresql://HOST:5432/DATABASE?sslmode=require&connectTimeout=10&socketTimeout=30
DB_URL=jdbc:postgresql://localhost:5432/menixjobai?sslmode=disable&connectTimeout=10&socketTimeout=30
DB_USERNAME=menix
DB_PASSWORD=change_this_local_password
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_DIAGNOSTICS_TOKEN=replace_with_a_long_random_admin_token
DDL_AUTO=update
SERVER_PORT=8080
UPLOAD_DIR=uploads
